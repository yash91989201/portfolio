{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^7.0.2",
      "@types/node": "^26.4.0",
      "@types/bun": "^1.4.0",
      "@phosphor-icons/react": "^2.1.10",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@orpc/server": "^1.15.0",
      "@orpc/client": "^1.15.0",
      "@orpc/openapi": "^1.15.0",
      "@orpc/zod": "^1.15.0",
      "better-auth": "1.7.2",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.5"
    }
  },
  "scripts": {
    "build": "nx run-many -t build",
    "check": "ultracite check",
    "check-types": "nx run-many -t check-types",
    "db:down": "docker compose down postgres",
    "db:generate": "nx run-many -t db:generate --projects=@portfolio/db",
    "db:migrate": "nx run-many -t db:migrate --projects=@portfolio/db",
    "db:push": "nx run-many -t db:push --projects=@portfolio/db",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:studio": "nx run-many -t db:studio --projects=@portfolio/db",
    "db:watch": "docker compose up postgres",
    "dev": "nx run-many -t dev",
    "dev:type-generator": "bun scripts/type-generator.ts --watch",
    "dev:web": "nx run-many -t dev --projects=web",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:up": "docker compose up -d --build",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@portfolio/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@portfolio/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "lefthook": "^2.1.10",
    "nx": "^23.1.2",
    "typescript": "catalog:",
    "ultracite": "7.10.7"
  },
  "packageManager": "bun@1.4.0"
}
